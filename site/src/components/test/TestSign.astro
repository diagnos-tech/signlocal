---
import { SAMPLE_TEXT } from "../../client/test-page/state.ts";
// Card 2: the sample text, the hash, and the button that signs it. The app opens its own window.
import type { LocaleCode } from "../../i18n/codes.ts";
import { text } from "../../lib/translate.ts";
import Button from "../ui/Button.astro";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const { t } = text(locale);
---

<section class="card test-card" aria-labelledby="sign-title">
  <header class="test-card__head">
    <span class="test-card__number" aria-hidden="true"></span>
    <h2 id="sign-title">{t("test.sign_title")}</h2>
  </header>
  <p>{t("test.sign_body")}</p>
  <div class="field">
    <span class="field__label">{t("test.message_label")}</span>
    <code id="sample">{SAMPLE_TEXT}</code>
  </div>
  <div class="field">
    <label class="field__label" for="hash">{t("test.hash")}</label>
    <select id="hash">
      <option value="SHA-256" selected>SHA-256</option>
      <option value="SHA-384">SHA-384</option>
      <option value="SHA-512">SHA-512</option>
    </select>
  </div>
  <div class="actions">
    <Button id="sign" disabled>{t("test.sign_button")}</Button>
    <p id="waiting" role="status" hidden>{t("test.waiting")}</p>
  </div>
  <p id="nocrypto" hidden>{t("test.no_crypto")}</p>
</section>

<style>
  .field {
    display: grid;
    justify-items: start;
    gap: 6px;
    margin-top: var(--ws-space-4);
  }

  .field__label {
    font: 600 0.875rem / 1.3 var(--web-font-sans);
    color: var(--ws-fg-muted);
  }

  select {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--ws-border-strong);
    border-radius: var(--ws-radius-lg);
    background: var(--ws-bg-surface);
    color: var(--ws-fg);
    font: 500 0.9375rem / 1 var(--web-font-sans);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ws-space-3) var(--ws-space-4);
    margin-top: var(--ws-space-5);
  }

  #waiting {
    color: var(--ws-fg-muted);
  }

  #nocrypto {
    margin-top: var(--ws-space-4);
    color: var(--ws-danger);
    font-weight: 600;
  }
</style>
