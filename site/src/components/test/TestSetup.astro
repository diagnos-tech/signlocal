---
// Card 1 of the test page: what is installed on this computer. One of five states shows at a
// time (checking, extension missing, app missing, app outdated, ready); client/test-page/ picks it.
import type { LocaleCode } from "../../i18n/codes.ts";
import { pagePath } from "../../lib/routes.ts";
import { text } from "../../lib/translate.ts";
import Button from "../ui/Button.astro";
import Callout from "../ui/Callout.astro";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const { t } = text(locale);
const install = pagePath("install", locale);
---

<section class="card test-card" aria-labelledby="setup-title">
  <header class="test-card__head">
    <span class="test-card__number" aria-hidden="true"></span>
    <h2 id="setup-title">{t("test.setup_title")}</h2>
  </header>
  <div id="setup" role="status" aria-live="polite">
    <p data-state="checking">{t("test.checking")}</p>
    <Callout variant="warning" data-state="extension-missing" hidden>
      <h3>{t("test.ext_missing_title")}</h3>
      <p>{t("test.ext_missing")}</p>
      <div><Button id="install-ext" href={install} size="md">{t("test.install_ext")}</Button></div>
    </Callout>
    <Callout variant="warning" data-state="app-missing" hidden>
      <h3>{t("test.app_missing_title")}</h3>
      <p>{t("test.app_missing")}</p>
      <div><Button id="install-app" href={install} size="md">{t("test.install_app")}</Button></div>
    </Callout>
    <Callout variant="warning" data-state="outdated" hidden>
      <h3>{t("test.outdated_title")}</h3>
      <p>{t("test.outdated")}</p>
      <div><Button id="update-app" href={install} size="md">{t("test.update_app")}</Button></div>
    </Callout>
    <Callout variant="success" data-state="ready" hidden>
      <h3>{t("test.ready_title")}</h3>
      <p>{t("test.ready")}</p>
      <p class="versions">
        {t("test.ext_version")}: <span id="v-ext">-</span> · {t("test.app_version")}: <span id="v-app">-</span>
      </p>
    </Callout>
  </div>
  <div class="test-card__actions">
    <Button id="recheck" variant="secondary" size="md" icon="arrow-clockwise">{t("test.recheck")}</Button>
    <a href={pagePath("activate", locale)}>{t("activate.link")}</a>
  </div>
</section>

<style>
  h3 {
    font: 600 1rem / 1.3 var(--web-font-sans);
    letter-spacing: 0;
  }

  /* Room for the tallest state, so the answer never pushes the next card down. */
  #setup {
    min-height: 15rem;
  }

  @media (min-width: 640px) {
    #setup {
      min-height: 10rem;
    }
  }

  .versions {
    font-size: 0.875rem;
    color: var(--ws-fg-muted);
    font-variant-numeric: tabular-nums;
  }

  [data-state="checking"] {
    color: var(--ws-fg-muted);
  }

  .test-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ws-space-3) var(--ws-space-5);
    margin-top: var(--ws-space-4);
  }
</style>
