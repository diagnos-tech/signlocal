---
// The three systems, each with what the release supports and, for Linux, where it is tested.
import type { LocaleCode } from "../../i18n/codes.ts";
import { SUPPORT } from "../../lib/site.ts";
import { text } from "../../lib/translate.ts";
import { OS_NAMES } from "../../platform/catalog.ts";
import { GLIBC_MIN } from "../../platform/facts.ts";
import { OS_IDS } from "../../platform/types.ts";
import OsMark from "../ui/OsMark.astro";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const { t } = text(locale);
const details = {
  windows: [t("compat.windows_detail")],
  macos: [t("compat.macos_detail", { version: SUPPORT.macos })],
  linux: [
    t("compat.linux_detail", { glibc: GLIBC_MIN }),
    t("compat.linux_tested", { list: SUPPORT.linuxTested.join(", ") }),
  ],
} as const;
---

<div class="systems">
  {
    OS_IDS.map((os) => (
      <article class="card systems__card">
        <h3><OsMark os={os} size={32} />{OS_NAMES[os]}</h3>
        {details[os].map((line) => <p>{line}</p>)}
      </article>
    ))
  }
</div>

<style>
  .systems {
    display: grid;
    gap: var(--ws-space-4);
  }

  .systems__card {
    display: grid;
    align-content: start;
    gap: var(--ws-space-3);
    padding: var(--ws-space-5);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: var(--ws-space-3);
    font: 650 1.1875rem / 1.3 var(--web-font-sans);
  }

  p {
    font-size: 0.9375rem;
    color: var(--ws-fg-muted);
  }

  @media (min-width: 900px) {
    .systems {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
