---
// Which browser works on which system, from which version, and where the extension comes from.
// On a phone each row becomes a card: the headings travel with the cells as data-label.
import type { LocaleCode } from "../../i18n/codes.ts";
import { PROJECT, SUPPORT } from "../../lib/site.ts";
import { text } from "../../lib/translate.ts";
import { BROWSER_NAMES, browserTiles, OS_NAMES } from "../../platform/catalog.ts";
import { SAFARI_MIN } from "../../platform/facts.ts";
import { extensionSource } from "../../platform/stores.ts";
import { OS_IDS } from "../../platform/types.ts";
import BrowserLogo from "../ui/BrowserLogo.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const { t } = text(locale);
const browsers = Object.keys(BROWSER_NAMES) as (keyof typeof BROWSER_NAMES)[];
const minimum = (id: (typeof browsers)[number]) =>
  id === "safari" ? SAFARI_MIN : id === "firefox" ? SUPPORT.firefox : SUPPORT.chromium;
function extension(id: (typeof browsers)[number]): string {
  if (id === "safari") return t("compat.store_safari");
  const source = extensionSource(id, PROJECT.extension);
  return source.store
    ? t("compat.store_live", { store: source.store.name })
    : t("compat.store_pending");
}
---

<div class="matrix">
  <table>
    <thead>
      <tr>
        <th scope="col">{t("compat.col_browser")}</th>
        {OS_IDS.map((os) => <th scope="col">{OS_NAMES[os]}</th>)}
        <th scope="col">{t("compat.col_extension")}</th>
      </tr>
    </thead>
    <tbody>
      {
        browsers.map((id) => (
          <tr>
            <th scope="row"><BrowserLogo browser={id} size={20} />{BROWSER_NAMES[id]}</th>
            {OS_IDS.map((os) => (
              <td data-label={OS_NAMES[os]}>
                {browserTiles(os).includes(id) ? (
                  <span class="yes"><Icon name="check" size={16} /><span class="sr-only">{t("compat.supported")}: </span>{t("compat.min_version", { version: minimum(id) })}</span>
                ) : (
                  <span class="no"><span aria-hidden="true">—</span><span class="sr-only">{t("compat.not_available")}</span></span>
                )}
              </td>
            ))}
            <td data-label={t("compat.col_extension")}>{extension(id)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--ws-border);
    border-radius: var(--web-radius-xl);
    background: var(--ws-bg-surface);
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 12px 16px;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--ws-border);
  }

  thead th {
    background: var(--web-band);
    font-size: 0.8125rem;
    color: var(--ws-fg-muted);
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  tbody th {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }

  .yes {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ws-success);
    font-variant-numeric: tabular-nums;
  }

  .no {
    color: var(--ws-fg-subtle);
  }

  td:last-child {
    color: var(--ws-fg-muted);
  }

  @media (max-width: 899px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    table {
      border: 0;
      background: none;
    }

    tr {
      margin-bottom: var(--ws-space-3);
      border: 1px solid var(--ws-border);
      border-radius: var(--web-radius-xl);
      background: var(--ws-bg-surface);
      overflow: hidden;
    }

    td {
      display: flex;
      justify-content: space-between;
      gap: var(--ws-space-4);
    }

    td::before {
      content: attr(data-label);
      color: var(--ws-fg-muted);
    }

    td:last-child {
      border-bottom: 0;
    }
  }
</style>
