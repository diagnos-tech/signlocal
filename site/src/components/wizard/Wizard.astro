---
// The install wizard: one card, one question at a time. Without JavaScript the card is the
// whole written guide (every system, browser and certificate, each under its own heading);
// with it, wizard/main.ts shows one step and the cards that match the choices.
import { STRINGS as DEVICE_STRINGS } from "../../client/device-notice.ts";
import type { LocaleCode } from "../../i18n/codes.ts";
import type { ReleaseInfo } from "../../lib/data-types.ts";
import { pickableKinds } from "../../lib/devices.ts";
import { PROJECT } from "../../lib/site.ts";
import { text } from "../../lib/translate.ts";
import { extensionSource } from "../../platform/stores.ts";
import { BROWSER_IDS } from "../../platform/types.ts";
import type { WizardData } from "../../wizard/data.ts";
import { STRINGS as WIZARD_STRINGS } from "../../wizard/strings.ts";
import ClientStrings from "../ui/ClientStrings.astro";
import StepBrowser from "./StepBrowser.astro";
import StepCertificate from "./StepCertificate.astro";
import Stepper from "./Stepper.astro";
import StepResult from "./StepResult.astro";
import StepSystem from "./StepSystem.astro";
import WizardNav from "./WizardNav.astro";

interface Props {
  locale: LocaleCode;
  release: ReleaseInfo | null;
}
const { locale, release } = Astro.props;
const { t } = text(locale);
const data: WizardData = {
  devices: pickableKinds(),
  channels: Object.fromEntries(
    BROWSER_IDS.map((id) => [id, extensionSource(id, PROJECT.extension).channel]),
  ) as WizardData["channels"],
  minAppVersion: PROJECT.minAppVersion,
};
const json = JSON.stringify(data);
---

<section class="wizard" data-wizard data-has-release={release ? "yes" : "no"} aria-labelledby="wizard-title">
  <h2 id="wizard-title" class="sr-only">{t("wizard.title")}</h2>
  <div class="wizard__top"><Stepper locale={locale} /></div>
  <p class="sr-only" aria-live="polite" data-announce></p>
  <div class="wizard__body">
    <StepSystem locale={locale} />
    <StepBrowser locale={locale} />
    <StepCertificate locale={locale} />
    <StepResult locale={locale} release={release} />
  </div>
  <WizardNav locale={locale} />
</section>
<ClientStrings module="wizard" keys={WIZARD_STRINGS} locale={locale} />
<ClientStrings module="device" keys={DEVICE_STRINGS} locale={locale} />
<script is:inline type="application/json" id="wizard-data" set:html={json} />

<style>
  .wizard {
    max-width: var(--web-wizard);
    margin: 0 auto;
    border: 1px solid var(--ws-border);
    border-radius: var(--web-radius-2xl);
    background: var(--ws-bg-surface);
    box-shadow: var(--web-shadow-md);
  }

  .wizard__top {
    padding: 28px 40px 8px;
  }

  .wizard__body {
    min-height: 440px;
    padding: 24px 40px 32px;
  }

  /* Scripts decide which step shows; until they have run nothing flashes, and the card keeps
     the height of a typical step so what is below it does not jump. */
  :global(html.js) .wizard:not([data-ready]) :global(.wizard__step) {
    display: none;
  }

  :global(html.js) .wizard:not([data-ready]) .wizard__body {
    min-height: 560px;
  }

  /* Without scripts there are no questions, only the guide. */
  :global(html:not(.js)) .wizard__top,
  :global(html:not(.js)) .wizard :global(.wizard__step:not(.wizard__step--result)),
  :global(html:not(.js)) .wizard :global([data-nav]),
  :global(html:not(.js)) .wizard :global(.result-nav) {
    display: none;
  }

  .wizard :global(.wizard__step) {
    animation: step-in var(--ws-motion-slow) var(--ws-easing);
  }

  .wizard :global(.step__fieldset) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .wizard :global(.step__legend) {
    float: left;
    width: 100%;
    padding: 0;
    margin-bottom: 6px;
  }

  .wizard :global(.step__legend + *) {
    clear: both;
  }

  .wizard :global(.step__title) {
    font: 650 1.75rem / 1.2 var(--web-font-sans);
    letter-spacing: var(--web-tracking-h2);
    outline-offset: 4px;
  }

  .wizard :global(.step__hint) {
    margin-bottom: 24px;
    color: var(--ws-fg-muted);
  }

  .wizard :global(.step__error) {
    margin-bottom: var(--ws-space-4);
    color: var(--ws-danger);
    font-weight: 600;
  }

  .wizard :global(.step__tiles) {
    display: grid;
    gap: var(--ws-space-3);
  }

  .wizard :global(.step__tiles--os),
  .wizard :global(.step__tiles--distro),
  .wizard :global(.step__tiles--cert) {
    grid-template-columns: minmax(0, 1fr);
  }

  .wizard :global(.step__tiles--browser) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .wizard :global(.step__small) {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--ws-fg-subtle);
  }

  .wizard :global(.step__subset) {
    min-width: 0;
    margin: 28px 0 0;
    padding: 0;
    border: 0;
  }

  .wizard :global(.step__subset legend) {
    padding: 0;
    margin-bottom: 10px;
    font: 600 0.9375rem / 1.3 var(--web-font-sans);
  }

  .wizard :global(.segmented),
  .wizard :global(.step__subset),
  .wizard :global([data-os="macos"].callout) {
    margin-top: 28px;
  }

  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (min-width: 640px) {
    .wizard :global(.step__tiles--os) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--ws-space-4);
    }

    .wizard :global(.step__tiles--distro) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .wizard :global(.step__tiles--cert) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wizard :global(.step__tiles--browser) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .wizard {
      border-radius: 20px;
    }

    .wizard__top {
      padding: 16px 16px 4px;
    }

    .wizard__body {
      min-height: 0;
      padding: 18px 16px 24px;
    }

    .wizard :global(.step__title) {
      font-size: 1.4375rem;
    }
  }
</style>
