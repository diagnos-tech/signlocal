---
// Back on the left, Next on the right, under the step (steps 1–3). On a phone the bar sticks to
// the bottom of the screen with 48 px buttons side by side.
import type { LocaleCode } from "../../i18n/codes.ts";
import { text } from "../../lib/translate.ts";
import Button from "../ui/Button.astro";

interface Props {
  locale: LocaleCode;
}
const { t } = text(Astro.props.locale);
---

<div class="nav" data-nav>
  <Button variant="secondary" icon="arrow-left" data-back>{t("wizard.back")}</Button>
  <Button iconEnd="arrow-right" class="nav__next" data-next>
    <span data-next-text="next">{t("wizard.next")}</span>
    <span data-next-text="show" hidden>{t("wizard.show_steps")}</span>
  </Button>
</div>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ws-space-3);
    padding: 20px 40px;
    border-top: 1px solid var(--ws-border);
  }

  .nav :global(.nav__next) {
    margin-left: auto;
  }

  @media (max-width: 639px) {
    .nav {
      position: sticky;
      bottom: 0;
      z-index: 3;
      padding: 12px 16px max(12px, env(safe-area-inset-bottom));
      background: var(--ws-bg-surface);
      border-radius: 0 0 20px 20px;
    }

    .nav :global(.btn) {
      flex: 1;
    }
  }
</style>
