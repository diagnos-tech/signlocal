---
// The four parties of a signature, and what each one does and never sees; the dashed frame
// marks everything that happens on the person's own computer.
import type { LocaleCode } from "../../i18n/codes.ts";
import { text } from "../../lib/translate.ts";
import Icon from "../ui/Icon.astro";
import WindowMock from "./WindowMock.astro";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const { t } = text(locale);
const website = { icon: "globe", title: t("home.how1_title"), body: t("home.how1") };
const local = [
  { icon: "puzzle-piece", title: t("home.how2_title"), body: t("home.how2") },
  { icon: "seal-check", title: t("home.how3_title"), body: t("home.how3") },
  { icon: "usb", title: t("home.how4_title"), body: t("home.how4") },
];
---

<section class="section section--band" aria-labelledby="how-title">
  <div class="container">
    <div class="section__head">
      <h2 id="how-title">{t("home.how_title")}</h2>
      <p class="section__lead">{t("home.how_lead")}</p>
    </div>
    <div class="how">
      <div class="how__steps">
        <div class="how__step card">
          <span class="how__bubble"><Icon name={website.icon} size={24} /></span>
          <div><h3>{website.title}</h3><p>{website.body}</p></div>
        </div>
        <div class="how__local">
          <p class="how__local-label"><Icon name="lock-simple" size={16} />{t("home.how_local")}</p>
          {
            local.map((step) => (
              <div class="how__step card">
                <span class="how__bubble"><Icon name={step.icon} size={24} /></span>
                <div><h3>{step.title}</h3><p>{step.body}</p></div>
              </div>
            ))
          }
        </div>
        <p class="how__back"><Icon name="arrow-left" size={20} />{t("home.how_back")}</p>
        <p class="how__formats">{t("home.how_formats")}</p>
      </div>
      <WindowMock locale={locale} />
    </div>
  </div>
</section>

<style>
  .how {
    display: grid;
    gap: var(--web-space-10);
    align-items: start;
  }

  .how__steps {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .how__step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 14px;
    padding: 18px 20px;
  }

  .how__bubble {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--web-ink-100);
    color: var(--ws-accent-fg);
  }

  .how__step h3 {
    margin: 2px 0 4px;
    font: 600 1.0625rem / 1.3 var(--web-font-sans);
    letter-spacing: 0;
  }

  .how__step p {
    font-size: 0.9375rem;
    color: var(--ws-fg-muted);
  }

  .how__local {
    display: grid;
    gap: 12px;
    padding: 14px;
    border: 2px dashed var(--web-ink-400);
    border-radius: 18px;
  }

  .how__local-label {
    display: flex;
    align-items: center;
    gap: var(--ws-space-2);
    padding: 2px 4px;
    font: 600 0.875rem / 1.3 var(--web-font-sans);
    color: var(--ws-accent-fg);
  }

  .how__back {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border: 1px solid var(--ws-success-border);
    border-radius: 14px;
    background: var(--ws-success-soft);
    font-size: 0.9375rem;
  }

  .how__back :global(.icon) {
    color: var(--ws-success);
  }

  .how__formats {
    padding-inline: 4px;
    font-size: 0.875rem;
    color: var(--ws-fg-muted);
  }

  @media (min-width: 900px) {
    .how {
      grid-template-columns: minmax(0, 1fr) 440px;
      gap: 64px;
    }
  }
</style>
