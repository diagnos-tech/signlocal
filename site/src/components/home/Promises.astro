---
// The four promises, as cards in a 2 × 2 grid, and the way to the privacy page.
import type { LocaleCode } from "../../i18n/codes.ts";
import { pagePath } from "../../lib/routes.ts";
import { text } from "../../lib/translate.ts";
import Icon from "../ui/Icon.astro";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const { t } = text(locale);
const promises = [
  { icon: "lock-simple", title: t("home.p1_title"), body: t("home.p1") },
  { icon: "shield-check", title: t("home.p2_title"), body: t("home.p2") },
  { icon: "signature", title: t("home.p3_title"), body: t("home.p3") },
  { icon: "hash", title: t("home.p4_title"), body: t("home.p4") },
];
---

<section class="section" aria-labelledby="promises-title">
  <div class="container">
    <div class="section__head">
      <h2 id="promises-title">{t("home.promises_title")}</h2>
    </div>
    <ul class="promises">
      {
        promises.map((promise) => (
          <li class="promises__card card">
            <span class="promises__bubble"><Icon name={promise.icon} size={24} /></span>
            <div>
              <h3>{promise.title}</h3>
              <p>{promise.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="promises__more"><a href={pagePath("privacy", locale)}>{t("home.privacy_link")}</a></p>
  </div>
</section>

<style>
  .promises {
    display: grid;
    gap: var(--ws-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .promises__card {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: var(--ws-space-4);
    padding: var(--ws-space-6);
  }

  .promises__bubble {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--web-ink-100);
    color: var(--ws-accent-fg);
  }

  h3 {
    margin-bottom: 6px;
    font: 600 1.125rem / 1.3 var(--web-font-sans);
    letter-spacing: 0;
  }

  p {
    font-size: 0.9375rem;
    color: var(--ws-fg-muted);
  }

  .promises__more {
    margin-top: var(--ws-space-5);
  }

  .promises__more a {
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .promises {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
