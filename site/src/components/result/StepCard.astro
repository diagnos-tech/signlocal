---
// One card of the result: a number (counted on the cards that are showing), a title, an
// optional live status and the body. `data-card` names it for the recipe test; the other
// data attributes (data-os, data-browser …) are the conditions that show or hide it.
import type { LocaleCode } from "../../i18n/codes.ts";
import { text } from "../../lib/translate.ts";
import Icon from "../ui/Icon.astro";

interface Props {
  card: string;
  id: string;
  /** Once signlocal is working, the steps fold behind "Show the steps again" (needs `locale`). */
  locale?: LocaleCode;
  [attribute: string]: unknown;
}
const { card, id, locale, ...conditions } = Astro.props;
const again = locale ? text(locale).t("result.show_again") : undefined;
---

<section class="step-card" data-card={card} aria-labelledby={`${id}-title`} {...conditions}>
  <header class="step-card__head">
    <span class="step-card__number" aria-hidden="true"></span>
    <div class="step-card__title" id={`${id}-title`}><slot name="title" /></div>
    <div class="step-card__live" aria-live="polite"><slot name="live" /></div>
  </header>
  {
    again ? (
      <details class="again" data-again open>
        <summary class="again__summary"><Icon name="caret-right" size={16} />{again}</summary>
        <div class="step-card__body"><slot /></div>
      </details>
    ) : (
      <div class="step-card__body"><slot /></div>
    )
  }
</section>

<style>
  .step-card {
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--ws-border);
    border-radius: var(--web-radius-xl);
    background: var(--ws-bg-surface);
    box-shadow: var(--web-shadow-xs);
    counter-increment: card;
  }

  .step-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-bottom: 14px;
  }

  .step-card__number {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--web-ink-100);
    color: var(--ws-accent-fg);
    font: 700 0.9375rem / 1 var(--web-font-sans);
  }

  .step-card__number::before {
    content: counter(card);
  }

  .step-card__title {
    flex: 1;
    min-width: 0;
  }

  .step-card__title :global(h3) {
    font: 650 1.25rem / 1.3 var(--web-font-sans);
    letter-spacing: var(--web-tracking-h3);
  }

  .step-card__live {
    display: flex;
    gap: var(--ws-space-2);
  }

  .step-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ws-space-3);
    min-width: 0;
  }

  .again:not([data-collapsible]) > .again__summary {
    display: none;
  }

  .again__summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: var(--ws-space-3);
    color: var(--ws-accent-fg);
    font: var(--web-text-label);
    cursor: pointer;
    list-style: none;
  }

  .again__summary::-webkit-details-marker {
    display: none;
  }

  .again[open] > .again__summary :global(.icon) {
    transform: rotate(90deg);
  }

  .step-card__body :global(p) {
    margin: 0;
  }

  .step-card__body :global(ol) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    margin: 0;
    padding-left: 22px;
  }

  .step-card__body :global(li) {
    min-width: 0;
    padding-left: 4px;
  }

  .step-card__body :global(.variant-heading) {
    margin-top: var(--ws-space-3);
    font: 650 0.9375rem / 1.3 var(--web-font-sans);
    color: var(--ws-fg-muted);
  }

  @media (min-width: 640px) {
    .step-card {
      padding: 24px;
    }

    .step-card__live {
      margin-left: auto;
    }
  }
</style>
