---
// Shown instead of the install cards while nothing is published: honest about it, and with the
// ways to follow along or build from source. Never a broken download.
import type { LocaleCode } from "../../i18n/codes.ts";
import { PROJECT } from "../../lib/site.ts";
import { text } from "../../lib/translate.ts";
import Button from "../ui/Button.astro";
import Callout from "../ui/Callout.astro";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const { t, html } = text(locale);
---

<section class="no-release" data-card="no-release" data-release="no" aria-labelledby="no-release-title">
  <Callout variant="info">
    <h3 id="no-release-title">{t("norelease.title")}</h3>
    <p>{t("norelease.body")}</p>
    <div>
      <Button href={`${PROJECT.repository}/releases`} variant="secondary" external locale={locale} iconEnd="arrow-square-out">
        {t("norelease.follow")}
      </Button>
    </div>
    <p class="no-release__source" set:html={html("norelease.source")} />
  </Callout>
</section>

<style>
  h3 {
    font: 650 1.25rem / 1.3 var(--web-font-sans);
    letter-spacing: var(--web-tracking-h3);
  }

  .no-release__source {
    font-size: 0.875rem;
    color: var(--ws-fg-muted);
  }
</style>
