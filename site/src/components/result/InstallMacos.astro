---
// macOS: the Terminal command (automatic), or the universal zip and how to move the app (manual).
import type { LocaleCode } from "../../i18n/codes.ts";
import type { ReleaseInfo } from "../../lib/data-types.ts";
import { formatBytes } from "../../lib/format.ts";
import { assetOf } from "../../lib/release-files.ts";
import { text } from "../../lib/translate.ts";
import type { ArtifactNames } from "../../platform/artifacts.ts";
import { macosAutomatic } from "../../platform/commands.ts";
import Callout from "../ui/Callout.astro";
import CommandBlock from "../ui/CommandBlock.astro";
import FileCard from "../ui/FileCard.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  mode: "auto" | "manual";
  locale: LocaleCode;
  release: ReleaseInfo;
  names: ArtifactNames;
}
const { mode, locale, release, names } = Astro.props;
const { t, html } = text(locale);
const installer = assetOf(release, names.installSh);
const command = macosAutomatic({ url: installer.url, sha256: installer.sha256 }, release.version);
const file = assetOf(release, names.macos);
---

<div data-os="macos">
  <h4 class="variant-heading nojs-only">macOS</h4>
  {
    mode === "auto" ? (
      <>
        <ol>
          <li set:html={html("install.mac_open")} />
          <li>
            <span set:html={html("install.paste")} />
            <CommandBlock id="cmd-macos-auto" command={command} label={t("install.command_terminal")} locale={locale} />
          </li>
          <li>{t("install.wait_macos")}</li>
        </ol>
        <p class="what"><Icon name="info-fill" size={16} />{t("install.what_it_does")}</p>
      </>
    ) : (
      <>
        <FileCard id="file-macos" name={file.name} size={formatBytes(file.size, locale)} url={file.url} sha256={file.sha256} os="macos" locale={locale} />
        <ol>
          <li>{t("install.mac_manual_open")}</li>
          <li set:html={html("install.mac_manual_drag")} />
        </ol>
        <Callout variant="warning"><span set:html={html("install.mac_gatekeeper")} /></Callout>
      </>
    )
  }
</div>

<style>
  .what {
    display: flex;
    gap: var(--ws-space-2);
    font-size: 0.875rem;
    color: var(--ws-fg-muted);
  }

  .what :global(.icon) {
    margin-top: 3px;
    color: var(--ws-accent-fg);
  }
</style>
