---
// Always lowercase, never split-coloured, never an image.
interface Props {
  /** 18 px (footer) instead of 20 px (header). */
  small?: boolean;
}
const { small = false } = Astro.props;
---

<span class:list={["wordmark", { "wordmark--small": small }]}>signlocal</span>

<style>
  .wordmark {
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ws-fg);
  }

  .wordmark--small {
    font-size: 18px;
  }
</style>
