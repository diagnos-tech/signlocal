---
// What stays on the computer, what a website receives, and what this website does not do.
import Icon from "../components/ui/Icon.astro";
import type { LocaleCode } from "../i18n/codes.ts";
import Base from "../layouts/Base.astro";
import { PAGE_META } from "../lib/meta.ts";
import { text } from "../lib/translate.ts";

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const { t, html } = text(locale);
const meta = PAGE_META.privacy;
if (!meta) throw new Error("No meta for the privacy page");
const sections = [
  { icon: "desktop", title: t("privacy.h1"), body: [html("privacy.t1")] },
  { icon: "globe", title: t("privacy.h2"), body: [html("privacy.t2")] },
  { icon: "shield-check", title: t("privacy.h3"), body: [html("privacy.t3")] },
  { icon: "list-checks", title: t("privacy.h4"), body: [html("privacy.t4")] },
  {
    icon: "browsers",
    title: t("privacy.h5"),
    body: [html("privacy.t5"), html("privacy.t5_downloads")],
  },
  { icon: "lifebuoy", title: t("privacy.h6"), body: [html("privacy.t6")] },
];
---

<Base locale={locale} page="privacy" title={t(meta.title)} description={t(meta.description)}>
  <div class="container container--narrow privacy">
    <h1>{t("privacy.title")}</h1>
    <p class="lead">{t("privacy.lead")}</p>
    {
      sections.map((section) => (
        <section class="privacy__section">
          <span class="privacy__icon"><Icon name={section.icon} size={32} /></span>
          <div>
            <h2>{section.title}</h2>
            {section.body.map((paragraph) => <p set:html={paragraph} />)}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .privacy {
    display: grid;
    gap: var(--ws-space-6);
    padding-block: var(--web-space-10) var(--web-space-16);
  }

  .privacy__section {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: var(--ws-space-4);
    padding-top: var(--ws-space-6);
    border-top: 1px solid var(--ws-border);
  }

  .privacy__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--web-ink-100);
    color: var(--ws-accent-fg);
  }

  h2 {
    margin-bottom: var(--ws-space-2);
    font: var(--web-text-h3);
  }

  p + p {
    margin-top: var(--ws-space-2);
  }

  p {
    max-width: var(--web-measure);
  }
</style>
