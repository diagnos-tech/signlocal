{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4174 bun scripts/serve.ts",
      "startServerReadyPattern": "Serving dist/",
      "url": [
        "http://localhost:4174/",
        "http://localhost:4174/download.html",
        "http://localhost:4174/download.html?os=windows&arch=x64&browser=chrome&cert=token&step=result",
        "http://localhost:4174/pt-br/",
        "http://localhost:4174/test/",
        "http://localhost:4174/compatibility.html",
        "http://localhost:4174/developers.html"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --lang=en-US --accept-lang=en-US" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
