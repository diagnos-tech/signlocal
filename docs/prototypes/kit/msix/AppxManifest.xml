<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the websign-probe MSIX. build-msix.ps1 replaces every placeholder token
  with values from project.toml.

  What the proof depends on:
  - rescap:runFullTrust: a plain Win32 console program, no AppContainer.
  - rescap:unvirtualizedResources + desktop6:*WriteVirtualization disabled:
    writes to HKCU and %LOCALAPPDATA% reach the real registry and file system,
    where browsers look for native messaging hosts. With virtualization on,
    they would land in the package's private copy and no browser would see them.
  - uap5:AppExecutionAlias with desktop4:Subsystem="console": browsers start
    the host through the alias (files under WindowsApps cannot be started
    directly) and talk to it over stdin/stdout. Same pattern as Python from
    the Microsoft Store.
  - windows.protocol: the extension opens @@URL_SCHEME@@: once so the app can
    register itself, since Store packages run no install scripts.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop4 desktop6 rescap">

  <Identity
    Name="@@PACKAGE_NAME@@"
    Publisher="@@PUBLISHER@@"
    Version="@@VERSION@@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@@DISPLAY_NAME@@</DisplayName>
    <PublisherDisplayName>@@PUBLISHER_DISPLAY_NAME@@</PublisherDisplayName>
    <Description>Risk proof: native messaging host and signing probe.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application
      Id="Probe"
      Executable="@@EXECUTABLE@@"
      EntryPoint="Windows.FullTrustApplication"
      desktop4:SupportsMultipleInstances="true">
      <!-- Not in the Start menu: people reach it through the alias or the protocol. -->
      <uap:VisualElements
        DisplayName="@@DISPLAY_NAME@@"
        Description="Risk proof: native messaging host and signing probe."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="@@EXECUTABLE@@"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="@@ALIAS@@" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- Parameters replaces the URL on the command line: opening
             @@URL_SCHEME@@:anything runs `@@EXECUTABLE@@ register`. -->
        <uap3:Extension
          Category="windows.protocol"
          Executable="@@EXECUTABLE@@"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:Protocol Name="@@URL_SCHEME@@" Parameters="register" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
