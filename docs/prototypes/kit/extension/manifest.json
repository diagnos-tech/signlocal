{
  "manifest_version": 3,
  "name": "WebeSign (probe extension)",
  "version": "0.1.0",
  "description": "Test extension for the native messaging proofs. Bridges pages on localhost to the native host.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "config.js",
      "native-host.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "websign@dev.websign",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
